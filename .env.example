# =================================================================
# Distributed Video Processing Platform - Environment Configuration
# =================================================================

# Storage Settings
DATA_DIR=/data

# RabbitMQ Settings
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MySQL Database URLs (Service-Owned)
UPLOAD_DATABASE_URL=mysql+pymysql://video_user:video_pass@mysql:3306/upload_db
METADATA_DATABASE_URL=mysql+pymysql://video_user:video_pass@mysql:3306/metadata_db
ORCHESTRATOR_DATABASE_URL=mysql+pymysql://video_user:video_pass@mysql:3306/orchestrator_db
TRANSCODING_DATABASE_URL=mysql+pymysql://video_user:video_pass@mysql:3306/transcoding_db
THUMBNAIL_DATABASE_URL=mysql+pymysql://video_user:video_pass@mysql:3306/thumbnail_db

# Microservice URLs (Used by API Gateway)
UPLOAD_SERVICE_URL=http://video-upload-service:8001
METADATA_SERVICE_URL=http://video-metadata-service:8002
ORCHESTRATOR_SERVICE_URL=http://transcoding-orchestrator-service:8003
TRANSCODING_SERVICE_URL=http://transcoding-worker-service:8004
THUMBNAIL_SERVICE_URL=http://thumbnail-generation-service:8005
MEDIA_SERVICE_URL=http://media-delivery-service:8006
